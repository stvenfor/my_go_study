# 环境变量模板，可复制为 .env 供 docker-compose 使用。
# Supabase URL / anon key 见 configs/supabase.env；service_role 见 .env.local

APP_ENV=dev
SERVER_PORT=8080
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=my_go_study
# 启动期 DDL 闸门（parity-p0-1，详见 docs/migration-workflow.md）：
# 默认 false —— schema 由 migrations/ + make migrate-up 管；APP_ENV=lan|prod 时代码强制 false。
# DATABASE_AUTO_MIGRATE=true 只在本机 APP_ENV=dev 逃生门里有意义（configs/config.dev.yaml 已开）。
# DATABASE_SCHEMA_VERSION_CHECK=false 会关掉「版本落后拒启」，勿在共享环境这么干。
# DATABASE_MIGRATIONS_DIR=migrations
# DATABASE_SSLMODE=disable
REDIS_ADDR=localhost:6379
# RabbitMQ（queue.enabled=true 时 API/Worker 需要）
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# RABBITMQ_QUEUE=my_go_study.tasks
# RABBITMQ_PREFETCH=10
# Elasticsearch（交易全文；空则关闭。lan-up 默认 http://elasticsearch:9200）
# ELASTICSEARCH_URL=http://127.0.0.1:9200
# 本地联调可用占位值；APP_ENV=prod 会拒绝该值（长度需 ≥32 且非占位串）。
# compose 侧 JWT_SECRET 为必填项，缺失时 make lan-up 直接失败。详见 docs/startup-guide.md §13
JWT_SECRET=change-me-in-production

# 微信 / 支付宝 / 华为（填齐后客户端只需同步公开 AppID；Secret 勿进 App）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_MCH_ID=
# WECHAT_MCH_API_KEY=         # 商户 v2 密钥（验签用）：只写 .env.local
# WECHAT_MCH_NOTIFY_URL=https://your.domain/api/v1/payments/notify/wechat
# WECHAT_PAY_ENDPOINT=https://api.mch.weixin.qq.com   # 一般不用改；仅沙箱/代理时覆盖
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=         # 只写 .env.local
# ALIPAY_PUBLIC_KEY=          # 支付宝公钥（验回调签）：只写 .env.local
# ALIPAY_NOTIFY_URL=https://your.domain/api/v1/payments/notify/alipay
# ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# HUAWEI_CLIENT_ID=          # AGC 应用 Client ID
# HUAWEI_CLIENT_SECRET=      # AGC Client Secret（仅服务端）
# HUAWEI_REDIRECT_URI=       # 可选；与 AGC OAuth 回调一致时再填
# HUAWEI_IAP_APP_ID=         # IAP 服务端 JWT：应用 ID
# HUAWEI_IAP_ISSUER_ID=      # AGC API 密钥 Issuer ID
# HUAWEI_IAP_KEY_ID=         # Key ID（可选 kid）
# HUAWEI_IAP_PRIVATE_KEY_PEM= # PEM 私钥（可用 \n 表示换行）
# HUAWEI_IAP_SUBSCRIPTION_ROOT_URL= # 默认中国站订阅查询根 URL
# APPLE_IAP_SHARED_SECRET=   # App Store Connect 共享密钥（verifyReceipt）
# APPLE_IAP_BUNDLE_ID=       # 可选：App Bundle ID

# 极光推送（服务端 Master Secret；客户端 AppKey 在 Flutter PushConfig）
# JPUSH_APP_KEY=
# JPUSH_MASTER_SECRET=
# JPUSH_APNS_PRODUCTION=false

# 融云 IM（服务端 App Secret；客户端 App Key 在 Flutter EnvConfig / RONG_APP_KEY）
# RONGCLOUD_APP_KEY=
# RONGCLOUD_APP_SECRET=
# RONGCLOUD_API_BASE_URL=https://api.rong-api.com

# 可观测（lan-up / compose：Prometheus + Grafana + Alertmanager + 飞书）
# FEISHU_ALERT_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=admin
