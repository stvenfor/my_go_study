# 环境变量模板，可复制为 .env 供 docker-compose 使用。
# Supabase URL / anon key 见 configs/supabase.env；service_role 见 .env.local

APP_ENV=dev
SERVER_PORT=8080
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_DBNAME=my_go_study
REDIS_ADDR=localhost:6379
JWT_SECRET=change-me-in-production

# 微信 / 支付宝 / 华为（填齐后客户端只需同步公开 AppID；Secret 勿进 App）
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_MCH_ID=
# WECHAT_MCH_API_KEY=
# WECHAT_MCH_NOTIFY_URL=https://your.domain/api/v1/payments/wechat/notify
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_NOTIFY_URL=https://your.domain/api/v1/payments/alipay/notify
# HUAWEI_CLIENT_ID=          # AGC 应用 Client ID
# HUAWEI_CLIENT_SECRET=      # AGC Client Secret（仅服务端）
# HUAWEI_REDIRECT_URI=       # 可选；与 AGC OAuth 回调一致时再填
# HUAWEI_IAP_APP_ID=         # IAP 服务端 JWT：应用 ID
# HUAWEI_IAP_ISSUER_ID=      # AGC API 密钥 Issuer ID
# HUAWEI_IAP_KEY_ID=         # Key ID（可选 kid）
# HUAWEI_IAP_PRIVATE_KEY_PEM= # PEM 私钥（可用 \n 表示换行）
# HUAWEI_IAP_SUBSCRIPTION_ROOT_URL= # 默认中国站订阅查询根 URL
# APPLE_IAP_SHARED_SECRET=   # App Store Connect 共享密钥（verifyReceipt）
# APPLE_IAP_BUNDLE_ID=       # 可选：App Bundle ID

# 极光推送（服务端 Master Secret；客户端 AppKey 在 Flutter PushConfig）
# JPUSH_APP_KEY=
# JPUSH_MASTER_SECRET=
# JPUSH_APNS_PRODUCTION=false
