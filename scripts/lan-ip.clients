# ============================================================================
# 局域网 IP 同步 · 开关板              （读取者：scripts/sync-lan-ip.sh）
# ============================================================================
# 【怎么用】想同步哪个客户端 / 哪个文件，就把那一行行首的 "#" 去掉；
#          不想同步就保留（或加上）"#"。—— 只有未注释的行会生效。
#
# 【什么时候自动跑】make lan-up / make lan-run / make sync-lan-ip 都会先刷新 IP，
#          按当前网卡自动写入，不用手改。只想刷 IP、不启动任何东西：
#              make sync-lan-ip
#
# 【每行格式】4 个字段，必须用 TAB 分隔（不要改成空格）：
#              kind <TAB> 目录 <TAB> 文件 <TAB> 标记
#          kind=env    往「配置文件」写入 标记=IP（该文件应被各自仓库 gitignore）
#          kind=quote  把「标记」之后第一个引号里的值替换成 IP（标记需以引号结尾）
#
# 【路径规则】目录必须是 my_go_study 的同级目录 ../<名称>，目录名即客户端 ID。
#          目录或文件不存在时，脚本只打印「跳过（…不存在）」然后继续，不报错。
#          → 所以"改完没生效"时，先看输出里有没有跳过。
#
# 【⚠️ 尽量不要用 quote 改客户端源码】IP 是机器相关值，一旦进入 git 会被历史
#          反复覆盖，队友拉下来还得手改（my_ai_project 的 lan_host.dart 就
#          192.168.0.102 ↔ 172.16.0.43 翻过烙饼）。优先 kind=env + gitignore。
#
# 【临时一次性覆盖】不想改文件时，可用环境变量只同步指定客户端：
#              make lan-up LAN_CLIENTS=my_kmp_project,kmp_kuikly
#              make lan-up LAN_CLIENTS=all      # 清单内全部未注释行
# ============================================================================

# ── my_ai_project（Flutter）───────────────────────────────────────────────
env	../my_ai_project	.env.lan	BACKEND_HOST

# ── my_kmp_project（Kotlin Multiplatform）────────────────────────────────
# 放开下一行即同步它的 .env.lan（注意该仓库 .gitignore 暂未忽略 .env.lan，别误提交）：
#env	../my_kmp_project	.env.lan	BACKEND_HOST
# ⚠️ 下一行会改写已入 git 的源码 LanHost.kt，非必要不要放开：
#quote	../my_kmp_project	core/network/src/commonMain/kotlin/com.example.my_kmp_project/core/network/LanHost.kt	const val fallback: String = "

# ── my_rn_project（React Native）──────────────────────────────────────────
#env	../my_rn_project	.env.lan	BACKEND_HOST
#quote	../my_rn_project	packages/core/config/src/lanHost.ts	export const fallback = '

# ── kmp_kuikly（Kuikly + KMP）─────────────────────────────────────────────
# 注：该仓库的 LanHost.kt 目前不存在，quote 行会被自动跳过
#env	../kmp_kuikly	.env.lan	BACKEND_HOST
#quote	../kmp_kuikly	feature-home/src/commonMain/kotlin/com/example/kuikly/feature/home/pages/LanHost.kt	const val fallback: String = "

# ── uni_ai_project（uni-app）──────────────────────────────────────────────
#env	../uni_ai_project	.env.lan	BACKEND_HOST
#quote	../uni_ai_project	src/lan-host.ts	export const fallback = '

# ── 新增客户端 ────────────────────────────────────────────────────────────
# 照上面任意一段的格式加行即可，不用改脚本。示例：
#env	../my_new_app	.env.lan	BACKEND_HOST
