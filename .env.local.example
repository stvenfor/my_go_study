# 本地私密覆盖（不入库）。复制为 .env.local 后填写真实 service_role。
# make run / 联调脚本会自动加载 .env + .env.local
# make lan-up 会把下列变量注入 Docker app 容器。

# Dashboard → Settings → API Keys → service_role（勿提交到 Git）
SUPABASE_SERVICE_ROLE_KEY=

# 融云 IM（控制台 App Key / App Secret；勿提交）
# RONGCLOUD_APP_KEY=
# RONGCLOUD_APP_SECRET=
# RONGCLOUD_API_BASE_URL=https://api.rong-api.com
