# 复制为 .env.lan（不入库）后填写，供 make lan-up 使用。
# lan = 本地 Auth/Postgres + 局域网暴露（不再依赖 Supabase Cloud）。

APP_ENV=lan
AUTH_PROVIDER=local
SERVER_PORT=8080
GRPC_ENABLED=true
GRPC_PORT=9090

# 占位即可：make sync-lan-ip / make lan-up 会按当前网卡覆盖为真实 IPv4
REALTIME_PUBLIC_WS_HOST=YOUR_LAN_IP

# 联调白名单（逗号分隔）
AUTH_SESSION_WHITELIST_EMAILS=your-test@example.com
# AUTH_SESSION_WHITELIST_USER_IDS=uuid1,uuid2

# 可选：测试手机号 OTP（需 APP_ENV=dev|lan 等非正式环境；逗号分隔多号）
# AUTH_DEV_TEST_PHONE=13400000000,13400000001,13400000002,13400000003,13400000004
# AUTH_DEV_TEST_OTP=123456
# AUTH_DEV_TEST_PASSWORD=dev-test-phone-secret

JWT_SECRET=change-me-in-lan
